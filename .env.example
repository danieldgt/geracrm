# Copie para .env e ajuste. ⚠️ .env nunca vai para o git.

# Banco local (docker-compose). Porta 5442 evita colisão com outro Postgres
# na máquina — o do drezz ou um Testcontainers.
# ⚠️ geracrm_api, NÃO geracrm. O usuário do container é SUPERUSUÁRIO e
# superusuário ignora RLS — o isolamento entre empresas simplesmente não
# aconteceria, e nenhum teste perceberia.
# Crie o papel com: psql < infra/dev/setup-dev.sql
DATABASE_URL=postgres://geracrm_api:geracrm_dev@localhost:5442/geracrm

# Só para preparo de dados em teste e para migrations. Nunca para a API.
DATABASE_ADMIN_URL=postgres://geracrm:geracrm_dev@localhost:5442/geracrm

# ⚠️ Bypass total de autenticação. Só fora de produção.
DEV_TENANT_HEADER=on
DATABASE_REPLICA_URL=postgres://geracrm:geracrm_dev@localhost:5443/geracrm

# Object storage local (MinIO)
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=geracrm-dev
S3_ACCESS_KEY=geracrm
S3_SECRET_KEY=geracrm_dev_secret

# Meta — só a partir do E3-01. Em dev, dublê.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Cognito — só a partir do E1-01. Em dev, dublê.
# Cognito: sem estas, a API cai no header de dev (fora de prod). Em prod são obrigatórias.
# O tenant vem de custom:tenant_id do ID token (ADR-001).
COGNITO_USER_POOL_ID=us-east-1_QOhAjgnxj
COGNITO_CLIENT_ID=oh6qc4oosqm8b4c87ehcp445m
COGNITO_REGION=us-east-1

# Chave de cifra das credenciais de integração (por tenant).
# ⚠️ Em produção vem do cofre, nunca do arquivo.
CRYPTO_KEY=dev-only-nao-usar-em-producao

NODE_ENV=development
LOG_LEVEL=debug

# Chave de cifragem das credenciais de ERP (AES-256-GCM).
# ⚠️ Nunca guardada no banco: quem tirou um dump do Postgres tirou o dado E a
#    chave junto, e aí a cifragem não protegeu nada.
# ⚠️ Trocar esta chave torna ILEGÍVEIS todas as credenciais já gravadas — os
#    clientes precisam digitar de novo. Não é rotação automática.
# Gere com: openssl rand -base64 48
CREDENCIAL_CHAVE=chave-de-desenvolvimento-com-mais-de-32-caracteres

# ─────────────────────────────────────────────────────────────────────────────
# Google Ads (camada de aquisição — agencia-mkt)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ Estas credenciais são da PLATAFORMA, não do tenant. Uma MCC nossa atende
#    TODOS os clientes — o que muda por cliente é só o customerId na chamada.
#    Por isso vivem aqui, e não cifradas por tenant como as de canal/ERP.
#    Guardar por tenant criaria N cópias do mesmo segredo, com N chances de
#    vazar e nenhuma vantagem.
#
# ⚠️ Em produção vêm do painel do Railway. NUNCA de arquivo no repositório.
#
# Como obter: agencia-mkt/onboarding-google-ads.md (passos ② e ③).

# Central de API da MCC (ads.google.com/aw/apicenter).
GOOGLE_ADS_DEVELOPER_TOKEN=

# A conta de gerenciador. Aceita com ou sem hífen — o código normaliza.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-276-0756

# Cliente OAuth (console.cloud.google.com/auth/clients), tipo "App para computador".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gerado por: node infra/dev/gerar-refresh-token-google.mjs <caminho-do-json>
# ⚠️ Se a tela de consentimento OAuth estiver em "Testing", o Google REVOGA este
#    token a cada 7 DIAS e a integração quebra toda semana com `invalid_grant`.
#    Publique o app em produção: console.cloud.google.com/auth/audience
GOOGLE_OAUTH_REFRESH_TOKEN=

# ⚠️ A versão da API do Google Ads é CONFIGURÁVEL de propósito: o Google lança
#    mensalmente, cada versão vive ~1 ano, e na desativação TODAS as requisições
#    passam a FALHAR (não degradam). A v21 morreu em 05/08/2026. Versão fixa no
#    código seria um apagão com data marcada.
GOOGLE_ADS_API_VERSION=v25
