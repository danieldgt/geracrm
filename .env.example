# Copie para .env e ajuste. ⚠️ .env nunca vai para o git.

# Banco local (docker-compose). Porta 5442 evita colisão com outro Postgres
# na máquina — o do drezz ou um Testcontainers.
# ⚠️ geracrm_api, NÃO geracrm. O usuário do container é SUPERUSUÁRIO e
# superusuário ignora RLS — o isolamento entre empresas simplesmente não
# aconteceria, e nenhum teste perceberia.
# Crie o papel com: psql < infra/dev/setup-dev.sql
DATABASE_URL=postgres://geracrm_api:geracrm_dev@localhost:5442/geracrm

# Só para preparo de dados em teste e para migrations. Nunca para a API.
DATABASE_ADMIN_URL=postgres://geracrm:geracrm_dev@localhost:5442/geracrm

# ⚠️ Bypass total de autenticação. Só fora de produção.
DEV_TENANT_HEADER=on
DATABASE_REPLICA_URL=postgres://geracrm:geracrm_dev@localhost:5443/geracrm

# Object storage local (MinIO)
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=geracrm-dev
S3_ACCESS_KEY=geracrm
S3_SECRET_KEY=geracrm_dev_secret

# Meta — só a partir do E3-01. Em dev, dublê.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Cognito — só a partir do E1-01. Em dev, dublê.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# Chave de cifra das credenciais de integração (por tenant).
# ⚠️ Em produção vem do cofre, nunca do arquivo.
CRYPTO_KEY=dev-only-nao-usar-em-producao

NODE_ENV=development
LOG_LEVEL=debug
