{
  "$comment": "Fonte da verdade visual do GeraCRM. Consumido por Angular (custom properties CSS) e Expo (NativeWind). Direção e justificativa: docs/identidade-visual.md · ADR-012.",

  "primitivos": {
    "azul": {
      "50":  "#F4F7FC",
      "100": "#E6EDF8",
      "200": "#C9D9EF",
      "300": "#9DBAE2",
      "400": "#6B94D1",
      "500": "#3F6FBE",
      "600": "#2C56A0",
      "700": "#234380",
      "800": "#1B3260",
      "900": "#142442",
      "950": "#0D1830"
    },
    "neutro": {
      "$comment": "Não são cinzas puros — matiz 217°, saturação 8–12%. É o que evita o efeito de azul aplicado sobre template cinza.",
      "50":  "#F8FAFC",
      "100": "#EFF3F8",
      "200": "#DFE6EF",
      "300": "#C2CDDC",
      "400": "#94A3B8",
      "500": "#5A6B84",
      "600": "#44546B",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F1B2D"
    },
    "turquesa": { "300": "#5FD9D3", "500": "#0FB5AE", "700": "#0A8A85" },
    "rampa": {
      "$comment": "Degraus intermediários da rampa RFV — existiam só no texto de identidade-visual §3.",
      "fiel":      "#2AA79E",
      "potencial": "#3F92BE",
      "atencao":   "#DE8E2A",
      "semi":      "#D9703C",
      "hibernando":"#D4544A"
    },
    "ambar":    { "300": "#F5C563", "500": "#E8A317", "700": "#B87F0D" },
    "coral":    { "300": "#F08A8D", "500": "#E5484D", "700": "#B8383C" },
    "verde":    { "300": "#6FC48F", "500": "#2E9E5B", "700": "#237A46" },
    "violeta":  { "300": "#A88FE6", "500": "#7C5CD6", "700": "#6244B0" },
    "branco":   "#FFFFFF"
  },

  "semantico": {
    "claro": {
      "fundo":              "{branco}",
      "superficie":         "{azul.50}",
      "superficie-elevada": "{branco}",
      "superficie-hover":   "{azul.100}",
      "borda":              "{neutro.200}",
      "borda-forte":        "{neutro.300}",
      "borda-foco":         "{turquesa.500}",
      "texto":              "{neutro.900}",
      "texto-secundario":   "{neutro.500}",
      "texto-suave":        "{neutro.400}",
      "texto-invertido":    "{branco}",
      "acao":               "{azul.500}",
      "acao-hover":         "{azul.600}",
      "acao-pressionada":   "{azul.700}",
      "superficie-selecionada": "{azul.100}",
      "borda-erro":         "{coral.500}",
      "acao-texto":         "{branco}",
      "marca":              "{azul.700}",
      "ativo":              "{turquesa.500}",
      "atencao":            "{ambar.500}",
      "erro":               "{coral.500}",
      "sucesso":            "{verde.500}",
      "ia":                 "{violeta.500}"
    },
    "escuro": {
      "$comment": "Não é inversão automática — é a mesma paleta relida. Fundo azul profundo, não preto, e cores de estado clareadas para manter contraste sem agredir.",
      "fundo":              "{azul.950}",
      "superficie":         "{azul.900}",
      "superficie-elevada": "{azul.800}",
      "superficie-hover":   "{azul.800}",
      "borda":              "#24406B",
      "borda-forte":        "#33558A",
      "borda-foco":         "{turquesa.300}",
      "texto":              "#E8EEF7",
      "texto-secundario":   "{azul.300}",
      "texto-suave":        "#6E86A8",
      "texto-invertido":    "{neutro.900}",
      "acao":               "{azul.400}",
      "acao-hover":         "{azul.300}",
      "acao-pressionada":   "{azul.200}",
      "superficie-selecionada": "#1E3A6B",
      "borda-erro":         "{coral.300}",
      "acao-texto":         "{azul.950}",
      "marca":              "{azul.300}",
      "ativo":              "{turquesa.300}",
      "atencao":            "{ambar.300}",
      "erro":               "{coral.300}",
      "sucesso":            "{verde.300}",
      "ia":                 "{violeta.300}"
    }
  },

  "rfv": {
    "$comment": "Rampa contínua: a posição na rampa informa antes da leitura. NUNCA usada sem rótulo.",
    "campeao":            "{turquesa.500}",
    "cliente-fiel":       "{rampa.fiel}",
    "potencial-fiel":     "{rampa.potencial}",
    "cliente-promissor":  "{azul.500}",
    "cliente-recente":    "{azul.400}",
    "nao-perder":         "{neutro.400}",
    "em-risco":           "{ambar.500}",
    "precisa-atencao":    "{rampa.atencao}",
    "semi-perdido":       "{rampa.semi}",
    "hibernando":         "{rampa.hibernando}",
    "perdido":            "{coral.500}"
  },

  "janela": {
    "$comment": "Elemento assinatura — o anel/barra de janela de 24h. Movimento contínuo e lentíssimo: uma volta a cada 24h. Nunca pisca.",
    "aberta":     "{turquesa.500}",
    "terminando": "{ambar.500}",
    "fechada":    "{coral.500}",
    "trilho-claro":  "{neutro.200}",
    "trilho-escuro": "#24406B",
    "espessura-anel": "2px",
    "espessura-barra": "2px",
    "limite-atencao-horas": 2
  },

  "tipografia": {
    "familia": {
      "interface": "Geist Sans, IBM Plex Sans, system-ui, sans-serif",
      "dados":     "Geist Mono, IBM Plex Mono, ui-monospace, monospace",
      "$comment-dados": "SKU, telefone, protocolo, CNPJ, referência. Alinham em coluna e o olho acha a diferença entre dois SKUs parecidos."
    },
    "escala": {
      "kpi":      { "tamanho": "32px", "peso": 600, "altura": "36px", "tracking": "-0.02em", "numeros": "tabular" },
      "titulo":   { "tamanho": "20px", "peso": 600, "altura": "28px", "tracking": "-0.01em" },
      "secao":    { "tamanho": "15px", "peso": 600, "altura": "20px" },
      "corpo":    { "tamanho": "14px", "peso": 400, "altura": "20px" },
      "denso":    { "tamanho": "13px", "peso": 400, "altura": "18px", "$comment": "lista, tabela, card — o tamanho mais usado do produto" },
      "rotulo":   { "tamanho": "11px", "peso": 500, "altura": "14px", "tracking": "0.02em" },
      "dados":    { "tamanho": "13px", "peso": 400, "altura": "18px", "numeros": "tabular" }
    }
  },

  "espacamento": {
    "$comment": "Grade de 4px.",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px"
  },

  "raio": {
    "$comment": "Moderno sem virar bolha — cantos muito arredondados fazem ferramenta de trabalho parecer brinquedo.",
    "controle": "6px",
    "painel": "10px",
    "completo": "999px"
  },

  "elevacao": {
    "$comment": "Borda antes de sombra. Sombra só onde há sobreposição real.",
    "nenhuma": "none",
    "dropdown": "0 4px 12px rgba(13, 24, 48, 0.10)",
    "modal":    "0 16px 40px rgba(13, 24, 48, 0.18)"
  },

  "movimento": {
    "$comment": "Nada anima em loop, exceto o anel de janela — e ele leva 24h por volta. prefers-reduced-motion sempre respeitado.",
    "estado":  { "duracao": "120ms", "curva": "cubic-bezier(0.2, 0, 0.2, 1)" },
    "painel":  { "duracao": "200ms", "curva": "cubic-bezier(0.2, 0, 0, 1)" },
    "janela":  { "duracao": "24h",   "curva": "linear" }
  },

  "densidade": {
    "$comment": "Densidade é respeito com quem varre a tela o dia inteiro.",
    "linha-tabela": "32px",
    "item-lista": "56px",
    "card-kanban-min": "112px",
    "acento-lateral-card": "3px",
    "alvo-toque-app": "44px",
    "alvo-clique-console": "28px"
  }
}
