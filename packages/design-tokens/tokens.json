{
  "$comment": "Fonte da verdade visual do GeraCRM. Consumido por Angular (custom properties CSS) e Expo (NativeWind). Direção e justificativa: docs/identidade-visual.md · ADR-012.",

  "primitivos": {
    "azul": {
      "50":  "#F4F7FC",
      "100": "#E6EDF8",
      "200": "#C9D9EF",
      "300": "#9DBAE2",
      "400": "#6B94D1",
      "500": "#3F6FBE",
      "600": "#2C56A0",
      "700": "#234380",
      "800": "#1B3260",
      "900": "#142442",
      "950": "#0D1830"
    },
    "neutro": {
      "$comment": "Não são cinzas puros — matiz 217°, saturação 8–12%. É o que evita o efeito de azul aplicado sobre template cinza.",
      "50":  "#F8FAFC",
      "100": "#EFF3F8",
      "200": "#DFE6EF",
      "300": "#C2CDDC",
      "400": "#94A3B8",
      "450": "#718199",
      "500": "#5A6B84",
      "600": "#44546B",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F1B2D"
    },
    "turquesa": { "300": "#5FD9D3", "500": "#0FB5AE", "700": "#0A8A85" },
    "rampa": {
      "$comment": "Degraus intermediários da rampa RFV — existiam só no texto de identidade-visual §3.",
      "fiel":      "#2AA79E",
      "potencial": "#3F92BE",
      "atencao":   "#DE8E2A",
      "semi":      "#D9703C",
      "hibernando":"#D4544A"
    },
    "ambar":    { "300": "#F5C563", "500": "#E8A317", "700": "#B87F0D" },
    "coral":    { "300": "#F08A8D", "500": "#E5484D", "700": "#B8383C" },
    "verde":    { "300": "#6FC48F", "500": "#2E9E5B", "700": "#237A46" },
    "violeta":  { "300": "#A88FE6", "500": "#7C5CD6", "700": "#6244B0" },
    "laranja": {
      "$comment": "A MARCA (Drezz Hub). Derivada da identidade Drezz — brand500 #FF6732, brand600 #E5521F. É o acento do produto: ação, foco, selecionado, marca, links.",
      "50":  "#FFF3EC",
      "100": "#FFE3D6",
      "200": "#FFC7B0",
      "300": "#FF9E77",
      "400": "#FF7E4B",
      "500": "#FF6732",
      "600": "#E5521F",
      "700": "#C7431A",
      "800": "#9E3413",
      "900": "#7A2810"
    },
    "creme":    "#FFF8EC",
    "ink":      "#1F1A16",
    "quente": {
      "$comment": "Neutros QUENTES do tema CLARO — a família creme/areia da Drezz. O tema escuro segue no slate frio `neutro`. É o que faz o palco claro 'pertencer' à marca sem o laranja dominar.",
      "100": "#FBF3E6",
      "200": "#F3EADA",
      "300": "#EADFCB",
      "400": "#DBCDB4",
      "500": "#7C6F5E",
      "600": "#665B4D",
      "900": "#1F1A16"
    },
    "branco":   "#FFFFFF"
  },

  "semantico": {
    "claro": {
      "$comment": "Palco CREME QUENTE (família Drezz), LARANJA (marca Drezz Hub) só nos detalhes (ação, foco, selecionado, marca, links). Superfícies neutras quentes — nunca laranja dominante. Turquesa reservada à assinatura (anel de janela + 'ao vivo').",
      "fundo":              "{creme}",
      "superficie":         "{quente.100}",
      "superficie-elevada": "{branco}",
      "superficie-hover":   "{quente.200}",
      "borda":              "{quente.300}",
      "borda-forte":        "{quente.400}",
      "borda-controle":     "{quente.500}",
      "borda-foco":         "{laranja.600}",
      "texto":              "{quente.900}",
      "texto-secundario":   "{quente.600}",
      "texto-suave":        "{quente.500}",
      "texto-invertido":    "{branco}",
      "acao":               "{laranja.500}",
      "acao-hover":         "{laranja.600}",
      "acao-pressionada":   "{laranja.700}",
      "acao-suave":         "{laranja.50}",
      "superficie-selecionada": "{laranja.50}",
      "borda-erro":         "{coral.500}",
      "acao-texto":         "{ink}",
      "marca":              "{laranja.600}",
      "ativo":              "{turquesa.500}",
      "atencao":            "{ambar.500}",
      "atencao-suave":      "#FBF2DD",
      "erro":               "{coral.700}",
      "erro-suave":         "#FBEBEC",
      "sucesso":            "{verde.500}",
      "sucesso-suave":      "#E7F5EC",
      "ia":                 "{violeta.500}",
      "ia-suave":           "#F1ECFB"
    },
    "escuro": {
      "$comment": "Slate NEUTRO profundo (não azul, não preto), LARANJA (marca Drezz Hub) só nos detalhes — mesma disciplina do claro. Acento clareado (laranja.400/300) para contraste sem agredir no escuro. Turquesa reservada à assinatura.",
      "fundo":              "{neutro.900}",
      "superficie":         "#17222F",
      "superficie-elevada": "{neutro.800}",
      "superficie-hover":   "#253243",
      "borda":              "#2B3948",
      "borda-forte":        "#3B4A5C",
      "borda-controle":     "{neutro.400}",
      "borda-foco":         "{laranja.400}",
      "texto":              "#E8EEF7",
      "texto-secundario":   "{neutro.400}",
      "texto-suave":        "{neutro.500}",
      "texto-invertido":    "{neutro.900}",
      "acao":               "{laranja.400}",
      "acao-hover":         "{laranja.300}",
      "acao-pressionada":   "{laranja.200}",
      "acao-suave":         "#3C261B",
      "superficie-selecionada": "#33241A",
      "borda-erro":         "{coral.300}",
      "acao-texto":         "{ink}",
      "marca":              "{laranja.300}",
      "ativo":              "{turquesa.300}",
      "atencao":            "{ambar.300}",
      "atencao-suave":      "#2C2513",
      "erro":               "{coral.300}",
      "erro-suave":         "#2E1A1B",
      "sucesso":            "{verde.300}",
      "sucesso-suave":      "#16271C",
      "ia":                 "{violeta.300}",
      "ia-suave":           "#221B33"
    }
  },

  "rfv": {
    "$comment": "Rampa contínua: a posição na rampa informa antes da leitura. NUNCA usada sem rótulo.",
    "campeao":            "{turquesa.500}",
    "cliente-fiel":       "{rampa.fiel}",
    "potencial-fiel":     "{rampa.potencial}",
    "cliente-promissor":  "{azul.500}",
    "cliente-recente":    "{azul.400}",
    "nao-perder":         "{neutro.400}",
    "em-risco":           "{ambar.500}",
    "precisa-atencao":    "{rampa.atencao}",
    "semi-perdido":       "{rampa.semi}",
    "hibernando":         "{rampa.hibernando}",
    "perdido":            "{coral.500}"
  },

  "janela": {
    "$comment": "Elemento assinatura — o anel/barra de janela de 24h. Movimento contínuo e lentíssimo: uma volta a cada 24h. Nunca pisca.",
    "aberta":     "{turquesa.500}",
    "terminando": "{ambar.500}",
    "fechada":    "{coral.500}",
    "trilho-claro":  "{neutro.200}",
    "trilho-escuro": "#24406B",
    "espessura-anel": "2px",
    "espessura-barra": "2px",
    "limite-atencao-horas": 2
  },

  "tipografia": {
    "familia": {
      "interface": "Geist Sans, IBM Plex Sans, system-ui, sans-serif",
      "dados":     "Geist Mono, IBM Plex Mono, ui-monospace, monospace",
      "$comment-dados": "SKU, telefone, protocolo, CNPJ, referência. Alinham em coluna e o olho acha a diferença entre dois SKUs parecidos."
    },
    "escala": {
      "kpi":      { "tamanho": "32px", "peso": 600, "altura": "36px", "tracking": "-0.02em", "numeros": "tabular" },
      "titulo":   { "tamanho": "20px", "peso": 600, "altura": "28px", "tracking": "-0.01em" },
      "secao":    { "tamanho": "15px", "peso": 600, "altura": "20px" },
      "corpo":    { "tamanho": "14px", "peso": 400, "altura": "20px" },
      "denso":    { "tamanho": "13px", "peso": 400, "altura": "18px", "$comment": "lista, tabela, card — o tamanho mais usado do produto" },
      "rotulo":   { "tamanho": "11px", "peso": 500, "altura": "14px", "tracking": "0.02em" },
      "dados":    { "tamanho": "13px", "peso": 400, "altura": "18px", "numeros": "tabular" }
    }
  },

  "espacamento": {
    "$comment": "Grade de 4px.",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px"
  },

  "largura": {
    "$comment": "Largura máxima de conteúdo por tipo de tela. Denso (tabela/kanban/BI) é full-bleed (SEM cap); forma/leitura limitam para legibilidade e ficam centrados. Fonte única — sem max-width literal por tela.",
    "forma": "820px",
    "leitura": "640px"
  },

  "raio": {
    "$comment": "Moderno sem virar bolha — cantos muito arredondados fazem ferramenta de trabalho parecer brinquedo.",
    "controle": "6px",
    "painel": "10px",
    "completo": "999px"
  },

  "elevacao": {
    "$comment": "Borda antes de sombra. Sombra só onde há sobreposição real.",
    "nenhuma": "none",
    "dropdown": "0 4px 12px rgba(13, 24, 48, 0.10)",
    "modal":    "0 16px 40px rgba(13, 24, 48, 0.18)"
  },

  "movimento": {
    "$comment": "Nada anima em loop, exceto o anel de janela — e ele leva 24h por volta. prefers-reduced-motion sempre respeitado.",
    "estado":  { "duracao": "120ms", "curva": "cubic-bezier(0.2, 0, 0.2, 1)" },
    "painel":  { "duracao": "200ms", "curva": "cubic-bezier(0.2, 0, 0, 1)" },
    "janela":  { "duracao": "24h",   "curva": "linear" }
  },

  "densidade": {
    "$comment": "Densidade é respeito com quem varre a tela o dia inteiro.",
    "linha-tabela": "32px",
    "item-lista": "56px",
    "card-kanban-min": "112px",
    "acento-lateral-card": "3px",
    "alvo-toque-app": "44px",
    "alvo-clique-console": "28px"
  }
}
