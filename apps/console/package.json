{
  "name": "@geracrm/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "node scripts/gerar-versao.mjs && ng build",
    "typecheck": "node scripts/gerar-versao.mjs && ng build --configuration development --output-path dist/typecheck && tsc -p tsconfig.spec.json --noEmit",
    "test": "node scripts/gerar-versao.mjs && vitest run",
    "lint": "oxlint src public"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@geracrm/design-tokens": "workspace:*",
    "@geracrm/shared": "workspace:*",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
